# Copy this file to ".env" (same folder) and fill in your real values there.
# ai_rpg/.env is gitignored - it will never be committed. This .env.example file has no real
# secrets in it and is safe to commit. On a hosted deployment (Render, etc.), set these as real
# environment variables in the platform's dashboard instead of using a .env file.
#
# You only need a key for whichever model(s) you actually plan to use:
#   luna (default), sonnet, haiku, opus -> see providers.MODEL_REGISTRY

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# A long random string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random one is generated per process start, meaning logins reset on every restart -
# fine for local dev, but set a real value before deploying so sessions persist across restarts.
FLASK_SECRET_KEY=

# Optional: only needed if you want real "Login with Discord". Create an application at
# https://discord.com/developers/applications, add an OAuth2 redirect matching
# DISCORD_REDIRECT_URI below exactly, and copy its Client ID/Secret here. See README's Discord
# login section for the full walkthrough. Leave all three blank to skip Discord login entirely -
# every visitor still gets a working local profile automatically.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# Optional: only needed to run the Discord BOT (run_discord_bot.py), separately from login above.
# Get/reset from the Developer Portal's Bot page. Leave blank to skip running the bot - the web app
# itself never reads these two.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# Required only if you run the Discord bot AND want its actions to live-update the website in real
# time (see /api/internal/notify_turn in server.py). Generate one with the same command as
# FLASK_SECRET_KEY above; both server.py and run_discord_bot.py need the SAME value. Leave blank to
# skip - the bot still works, its actions just won't push live to anyone watching the website until
# they refresh.
INTERNAL_NOTIFY_SECRET=

# Real background-thread scheduler for multiplayer progression ticks (day/week/month advancement,
# the daily conclusion sweep - see scheduler.py). Off by default so plain dev runs and the test
# suite never start a background thread by accident. Set to 1 to enable - only meaningful once you
# actually have a multiplayer server running that needs its ticks to fire.
ENABLE_TICK_SCHEDULER=

# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# A long random string, shared between this proxy and Butterfly's Render deployment
# (as the OLLAMA_TUNNEL_SECRET env var there). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PROXY_SHARED_SECRET=

# Usually fine as the default - only change if Ollama is listening somewhere else.
OLLAMA_URL=http://localhost:11434

# Port this proxy listens on locally. The Cloudflare tunnel points here, never at Ollama directly.
PROXY_PORT=11435

# Optional - requests allowed per rolling 60-second window before this proxy starts returning 429.
# RATE_LIMIT_MAX_REQUESTS=60
